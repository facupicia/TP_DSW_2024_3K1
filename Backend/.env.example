# ==========================================
# EventLife Backend - Environment Variables
# ==========================================

# Entorno
NODE_ENV=development
PORT=3000

# Frontend URLs (CORS)
# Producción: https://event-life.netlify.app
# Desarrollo: http://localhost:4200
CLIENT_URL=https://event-life.netlify.app
CLIENT_URLS=https://event-life.netlify.app,http://localhost:4200

# Backend URL
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000

# ==========================================
# DATABASE (PostgreSQL)
# ==========================================

# Opción 1: URL completa (Neon, Railway, etc.)
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Opción 2: Variables separadas
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=eventlife

# ==========================================
# SECURITY
# ==========================================

# JWT Secret (generar uno fuerte para producción)
SECRET_KEY=your-super-secret-jwt-key-min-32-chars

# Encryption Key para tokens de MP (64 caracteres hex = 32 bytes)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-character-hex-encryption-key-for-production

# ==========================================
# MERCADOPAGO - PAYMENTS
# ==========================================

# MODO SANDBOX (para testing)
# Opción 1: Usar token de TEST (TEST-...)
# Opción 2: Forzar modo sandbox incluso con token de producción:
# MP_FORCE_SANDBOX_MODE=true

# Access Token de la plataforma (obligatorio)
# Sandbox: TEST-...
# Producción: APP_USR-...
MP_ACCESS_TOKEN=TEST-your-sandbox-token

# Credenciales de OAuth App (obligatorio para marketplace)
MP_CLIENT_ID=your-mp-app-id
MP_CLIENT_SECRET=your-mp-app-secret

# Webhook Secrets (opcionales pero recomendados)
# En SANDBOX se pueden omitir (las validaciones se saltearán automáticamente)
# En PRODUCCIÓN son altamente recomendados para seguridad

# Para webhooks de pagos (marketplace - /api/payment/webhook)
MP_WEBHOOK_SECRET=your-payment-webhook-secret

# Para webhooks de suscripciones (/api/subscription/webhook)
# Si no se configura, usa MP_WEBHOOK_SECRET
MP_SUBSCRIPTION_WEBHOOK_SECRET=your-subscription-webhook-secret

# URL de notificaciones de MP (webhook)
# En desarrollo usar ngrok: https://xxxx.ngrok.io/api/payment/webhook
# En producción: https://backend-eventlife.onrender.com/api/payment/webhook
MP_NOTIFICATION_URL=https://backend-eventlife.onrender.com/api/payment/webhook

# Token separado para suscripciones (opcional)
# Si no se configura, usa MP_ACCESS_TOKEN
MP_ACCESS_TOKEN_SUSCRIPCION=TEST-your-subscription-token

# URL de callback para suscripciones
MP_SUBSCRIPTION_BACK_URL=https://backend-eventlife.onrender.com

# ==========================================
# GOOGLE OAUTH
# ==========================================

ID_CLIENT_GOOGLE_OAUTH=your-google-oauth-client-id.apps.googleusercontent.com

# ==========================================
# EMAIL (Brevo/Sendinblue)
# ==========================================

MAIL_HOST=smtp.brevo.com
MAIL_PORT=587
MAIL_USER=your-brevo-smtp-user
MAIL_PASSWORD=your-brevo-smtp-password
MAIL_FROM=noreply@eventlife.com
BREVO_API_KEY=your-brevo-api-key

# ==========================================
# REDIS (Opcional)
# ==========================================

REDIS_URL=redis://localhost:6379

# ==========================================
# OPTIONAL / ADVANCED
# ==========================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Request timeout (ms)
REQUEST_TIMEOUT=30000
