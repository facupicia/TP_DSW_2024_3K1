{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "ts-node src/seed.ts",
    "test:payment": "ts-node-dev --quiet tests/payment.test.ts",
    "test:payment-idempotency": "ts-node-dev --quiet tests/payment.idempotency.ts",
    "verify:migration": "ts-node src/scripts/verify-migration.ts",
    "test:timestamp": "ts-node src/scripts/test-timestamp-column.ts",
    "test:db": "ts-node src/scripts/test-connection.ts",
    "test:auth": "ts-node-dev --quiet tests/auth.bugs.test.ts",
    "test:roles": "ts-node-dev --quiet tests/role-update.test.ts",
    "test:google": "ts-node-dev --quiet tests/google-auth.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:auth": "playwright test specs/auth.spec.ts",
    "test:e2e:events": "playwright test specs/events.spec.ts",
    "test:e2e:tickets": "playwright test specs/tickets.spec.ts",
    "test:e2e:admin": "playwright test specs/admin.spec.ts",
    "test:e2e:api": "playwright test specs/api.spec.ts",
    "test:e2e:chrome": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project='Mobile Chrome'",
    "test:e2e:ci": "playwright test --project=chromium --reporter=dot",
    "test:e2e:payments": "playwright test specs/payments.spec.ts",
    "test:e2e:sanity": "playwright test specs/sanity.spec.ts",
    "test:e2e:login": "playwright test specs/login-real.spec.ts",
    "test:e2e:edge": "playwright test specs/payments-edge-cases.spec.ts",
    "test:e2e:all-payments": "playwright test specs/payments*.spec.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": ">=18.18.0 <19.0.0"
  },
  "dependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.2.1",
    "geoip-lite": "^1.4.10",
    "google-auth-library": "^9.14.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^2.11.0",
    "morgan": "^1.10.0",
    "pdfkit": "^0.15.0",
    "pg": "^8.11.3",
    "qrcode": "^1.5.4",
    "redis": "^4.6.13",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-node-dev": "^2.0.0",
    "typeorm": "^0.3.20",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/geoip-lite": "^1.4.4",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.4.1",
    "@types/qrcode": "^1.5.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "nodemon": "^3.1.7",
    "typescript": "^5.6.2"
  }
