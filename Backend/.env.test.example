# Credenciales de test - Organizador
TEST_ORGANIZER_EMAIL=organizer@test.com
TEST_ORGANIZER_PASSWORD=Organizer123!

# Credenciales de test - Admin
TEST_ADMIN_EMAIL=admin@test.com
TEST_ADMIN_PASSWORD=Admin123!

# CI/CD
CI=false
